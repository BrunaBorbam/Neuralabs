+          />
+        </div>
+        <div className="grid grid-cols-3 gap-3.5">
+          <select value={form.people} onChange={handleChange('people')} className={inputClass}>
+            {['1', '2', '3', '4', '5', '6', '7', '8+'].map((n) => (
