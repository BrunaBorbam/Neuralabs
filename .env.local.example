# Google Analytics 4
# Obtenha seu GA4 ID em: https://analytics.google.com
# Formato: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Resend Email (para email capture)
# Obtenha sua chave em: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Seu email para receber submissões de formulário.
# Sem o prefixo NEXT_PUBLIC_ de propósito: essa variável só é lida no
# servidor (app/api/send-email/route.ts) — não precisa, e não deve, ir
# parar no JavaScript que o navegador do visitante baixa.
CONTACT_EMAIL=seu-email@example.com
