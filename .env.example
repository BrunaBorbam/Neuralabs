# Google Analytics - Public (fine to expose to the browser)
NEXT_PUBLIC_GA_ID=seu_google_analytics_4_id

# Discord Webhook para notificação de leads - SENSÍVEL.
# NUNCA prefixe com NEXT_PUBLIC_: esse prefixo faz o Next.js embutir o
# valor no JavaScript enviado ao navegador, ou seja, qualquer visitante
# consegue ler a URL do webhook inspecionando o site e usá-la pra
# spammar seu canal do Discord. Fica só no servidor sem o prefixo.
DISCORD_WEBHOOK=seu_discord_webhook_url

# Informações de Contato - Public (WhatsApp já é exibido no site)
NEXT_PUBLIC_WHATSAPP=5551992682717
NEXT_PUBLIC_EMAIL=seu@email.com
